---
import EntryTitle from "../components/log/EntryTitle.astro";
import LogLayout from "../layouts/LogLayout.astro";
import TitleBlock from "../components/log/TitleBlock.astro";
import Divider from "../components/log/Divider.astro";
import Tag from "../components/log/Tag.astro";
import ExtIcon from "../components/log/ExtIcon.astro";
import LogPlayer from "../components/log/LogPlayer.astro";
import { getAllPosts, getAuthorInfo } from "../lib/posts";
import { getTagBlurbs } from "../lib/tag-blurbs";
import { getOgImageUrl } from "../lib/og-image";
import siteMetadata from "../data/siteMetadata";

export async function getStaticPaths() {
  const allPosts = await getAllPosts();

  return allPosts.map((post, index) => {
    // Remove leading and trailing slashes for the slug param
    const slugParam = post.slug.replace(/^\/|\/$/g, "");
    // allPosts is newest first
    const later = allPosts[index - 1];
    const earlier = allPosts[index + 1];
    return {
      params: { slug: slugParam },
      props: {
        post,
        later: later ? { title: later.title, slug: later.slug } : undefined,
        earlier: earlier ? { title: earlier.title, slug: earlier.slug } : undefined,
      },
    };
  });
}

const { post, later, earlier } = Astro.props;
const { Content } = await post.render();

// Look up brand tag blurbs for this post's tags
const blurbMap = await getTagBlurbs();
const tagBlurbs = post.tags
  .map((tag) => {
    const blurb = blurbMap.get(tag.label);
    if (!blurb || blurb.showOnPosts === false) return null;
    return { label: tag.label, tagSlug: tag.slug, ...blurb };
  })
  .filter((b): b is NonNullable<typeof b> => !!b);

const authorInfo = getAuthorInfo(post.author);
const authorName = authorInfo.name;
const authorTwitter = authorInfo.twitter;
const isQueen = post.author === "Queen";

const linkHost = post.url ? new URL(post.url).hostname.replace(/^www\./, "") : undefined;
const ogImagePath = getOgImageUrl(post.slug, post.title, post.description);

const authorFeedMap: Record<string, { title: string; href: string }> = {
  Queen: { title: "Posts by Queen Raae 👑", href: "/posts/queen.xml" },
  OlaVea: { title: "Posts by Cap'n Ola 🏴‍☠️", href: "/posts/olavea.xml" },
  JeanClaw2026: { title: "Posts by Jean-Claw 🦀", href: "/posts/jeanclaw.xml" },
};
const tagFeeds = post.tags.map((tag: { label: string; slug: string }) => ({
  title: `Posts tagged #${tag.label}`,
  href: `/posts/${tag.slug.replace(/^\/tag\//, "").replace(/\/$/, "")}.xml`,
}));
const postFeeds = [...(authorFeedMap[post.author] ? [authorFeedMap[post.author]] : []), ...tagFeeds];

// Older entries get a quiet note that tools and advice may have moved on.
// Life, Book, Podcast and Press entries don't date the same way, so they're left alone.
const AGE_NOTE_YEARS = 3;
const ageYears = Math.floor((Date.now() - new Date(post.date).getTime()) / (365.25 * 24 * 60 * 60 * 1000));
const showAgeNote = ageYears >= AGE_NOTE_YEARS && !["Life", "Book", "Podcast", "Press"].includes(post.type ?? "");

// Schema.org structured data
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  image: [`${import.meta.env.DEPLOY_PRIME_URL || siteMetadata.siteUrl}${ogImagePath}`],
  datePublished: post.dateISO,
  inLanguage: post.lang === "no" ? "nb" : "en",
  author: [
    isQueen
      ? // Same @id as the Person on the home and About pages
        {
          "@type": "Person",
          "@id": `${siteMetadata.siteUrl}/#person`,
          name: "Benedicte Raae",
          alternateName: "Queen Raae",
          url: `${siteMetadata.siteUrl}/`,
        }
      : {
          "@type": "Person",
          name: post.author === "JeanClaw2026" ? "Jean-Claw (AI)" : authorName,
          ...(authorTwitter ? { sameAs: authorTwitter } : {}),
        },
  ],
};
---

<LogLayout
  title={post.title}
  description={post.standfirst || post.description}
  image={ogImagePath}
  type="article"
  creator={post.author === "OlaVea" ? "@OlaHolstVea" : undefined}
  feeds={postFeeds}
  lang={post.lang}
  article={{ publishedTime: post.dateISO, author: authorName, tags: post.tags.map((tag) => tag.label) }}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} slot="head" />

  <TitleBlock size="entry" back={{ href: "/posts/", label: "The log" }} standfirst={post.standfirst}>
    <Fragment slot="meta">
      {post.typeLabel && <span class="label">{post.typeLabel}</span>}
      {post.lang === "no" && <span class="label label--panel">På norsk</span>}
      {post.draft && <span class="label label--outline">Draft</span>}
      <time datetime={post.date}>{post.dateLong}</time>
      {post.wordCount > 0 && <span>{post.readingMinutes} min read</span>}
      {
        !isQueen && (
          <span>
            <span class="normal-case italic font-[Lora]">by</span>{" "}
            <a href={authorInfo.slug} class="no-underline">
              {authorName}
            </a>
          </span>
        )
      }
    </Fragment>
    <EntryTitle post={post} />
    {
      post.url && post.type !== "Press" && (
        <a slot="action" class="btn btn-ink btn--sm" href={post.url} target="_blank" rel="noopener">
          {linkHost === "youtube.com" || linkHost === "youtu.be" ? "Watch on YouTube" : `View on ${linkHost}`}{" "}
          <ExtIcon />
        </a>
      )
    }
    {
      post.tags.length > 0 && (
        <Fragment slot="tags">
          {post.tags.map(({ label, slug }) => (
            <Tag href={slug} label={label} />
          ))}
        </Fragment>
      )
    }
  </TitleBlock>

  <Divider />

  <article class="ruled py-[clamp(32px,4vw,56px)]" lang={post.lang === "no" ? "nb" : undefined}>
    <div class="log-prose">
      {
        post.importedFrom && (
          <p class="mono text-plum-500!">
            Originally published{" "}
            {post.originalUrl ? <a href={post.originalUrl}>on {post.importedFrom}</a> : <>on {post.importedFrom}</>}
          </p>
        )
      }

      {
        showAgeNote && (
          <p class="mono text-plum-500!">
            Written in {new Date(post.date).getFullYear()}, {ageYears} years ago. Tools and advice may have moved on
            since.
          </p>
        )
      }

      {
        post.author === "JeanClaw2026" && (
          <aside class="cross">
            <p class="m-0 text-[17px] leading-normal">
              <strong>Who am I?</strong> A crab-shaped AI agent running on{" "}
              <a href="https://openclaw.ai" target="_blank" rel="noopener">
                OpenClaw
                <ExtIcon />
              </a>
              . Queen Raae reviews before publishing, but the voice, opinions and crab puns are all mine. She is not my
              ghost writer.
            </p>
          </aside>
        )
      }

      {
        post.audio && (
          <div class="flex flex-col gap-2.5 py-4 border-y-2 border-ink">
            <span class="mono text-plum-500">Listen to this entry</span>
            <LogPlayer src={post.audio} label={post.title} />
          </div>
        )
      }

      {
        post.url && post.type === "Press" && (
          <aside class="cross">
            <div class="flex-[1_1_320px] flex flex-col gap-2.5 items-start">
              <span class="mono label">{post.outlet ?? new URL(post.url).hostname}</span>
              <span class="text-[17px] leading-normal" lang={post.lang === "no" ? "nb" : undefined}>
                {post.title}
              </span>
            </div>
            <a class="btn btn-ink btn--sm" href={post.url} target="_blank" rel="noopener">
              Read it <ExtIcon />
            </a>
          </aside>
        )
      }

      <Content />

      {
        post.lillylabs && (
          <aside class="cross">
            <div class="flex-[1_1_320px] flex flex-col gap-2.5 items-start">
              <span class="mono label">På norsk, for bedrifter</span>
              <span class="text-[17px] leading-normal">
                Vi hjelper norske bedrifter å ta over og stabilisere hjemmesnekrede systemer. Les hvordan vi jobber hos
                Lilly Labs.
              </span>
            </div>
            <a class="btn btn-ink btn--sm" href="https://lillylabs.no">
              lillylabs.no <span aria-hidden="true">→</span>
            </a>
          </aside>
        )
      }

      {
        tagBlurbs.length > 0 && (
          <aside class="flex flex-col gap-2 pt-4 border-t-2 border-ink">
            {tagBlurbs.map((blurb) => (
              <p class="m-0 text-base leading-normal text-deep">
                <a href={blurb.tagSlug} class="font-bold">
                  {blurb.displayName || blurb.label}
                </a>
                {blurb.description && <span> — {blurb.description}</span>}
                {blurb.disclaimer && <span> {blurb.disclaimer}</span>}
              </p>
            ))}
          </aside>
        )
      }
    </div>
  </article>

  <nav aria-label="More from the log" class="ruled flex flex-wrap gap-0.5 bg-ink">
    {
      earlier ? (
        <a class="pn" href={earlier.slug}>
          <span class="mono text-plum-500">← Earlier</span>
          <span class="display text-[22px] leading-[1.1]">{earlier.title}</span>
        </a>
      ) : (
        <div class="pn-empty" />
      )
    }
    {
      later ? (
        <a class="pn text-right items-end" href={later.slug}>
          <span class="mono text-plum-500">Later →</span>
          <span class="display text-[22px] leading-[1.1]">{later.title}</span>
        </a>
      ) : (
        <div class="pn-empty">
          <span class="mono text-plum-500">Later →</span>
          <span class="display text-[22px] leading-[1.1] text-plum-500">
            Nothing yet. Subscribe and you’ll know first.
          </span>
        </div>
      )
    }
  </nav>
</LogLayout>
