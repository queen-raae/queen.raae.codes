---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PageSection from "../components/PageSection.astro";
import PageSectionHeader from "../components/PageSectionHeader.astro";
import PageSectionBreadcrumbs from "../components/PageSectionBreadcrumbs.astro";
import Prose from "../components/Prose.astro";
import Badge from "../components/Badge.astro";
import Newsletter from "../components/Newsletter.astro";
import Posts from "../components/Posts.astro";
import PostByline from "../components/post/PostByline.astro";
import PostTagBlurbs from "../components/post/PostTagBlurbs.astro";
import { getAllPosts, getRelatedPosts, getAuthorInfo } from "../lib/posts";
import { getTagBlurbs } from "../lib/tag-blurbs";
import { getOgImagePath, getOgImageUrl } from "../lib/og-image";
import siteMetadata from "../data/siteMetadata";

export async function getStaticPaths() {
  const allPosts = await getAllPosts();

  return allPosts.map((post) => {
    // Remove leading and trailing slashes for the slug param
    const slugParam = post.slug.replace(/^\/|\/$/g, "");
    return {
      params: { slug: slugParam },
      props: { post, allPosts },
    };
  });
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();

const relatedPosts = getRelatedPosts(post, allPosts, 3, 0.7);

// Look up brand tag blurbs for this post's tags
const blurbMap = await getTagBlurbs();
const tagBlurbs = post.tags
  .map((tag) => {
    const blurb = blurbMap.get(tag.label);
    if (!blurb || blurb.showOnPosts === false) return null;
    return { label: tag.label, tagSlug: tag.slug, ...blurb };
  })
  .filter((b): b is NonNullable<typeof b> => !!b);

const authorInfo = getAuthorInfo(post.author);
const authorName = authorInfo.name;
const authorTwitter = authorInfo.twitter;

const ogImagePath = getOgImageUrl(post.slug, post.title, post.description);

const authorFeedMap: Record<string, { title: string; href: string }> = {
  Queen: { title: "Posts by Queen Raae 👑", href: "/posts/queen.xml" },
  OlaVea: { title: "Posts by Cap'n Ola 🏴‍☠️", href: "/posts/olavea.xml" },
  JeanClaw2026: { title: "Posts by Jean-Claw 🦀", href: "/posts/jeanclaw.xml" },
};
const tagFeeds = post.tags.map((tag: { label: string; slug: string }) => ({
  title: `Posts tagged #${tag.label}`,
  href: `/posts/${tag.slug.replace(/^\/tag\//, "").replace(/\/$/, "")}.xml`,
}));
const postFeeds = [...(authorFeedMap[post.author] ? [authorFeedMap[post.author]] : []), ...tagFeeds];

// Byline links (shown when the post has no audio narration)
const rssHref = `/posts/${post.author === "Queen" ? "queen" : post.author === "OlaVea" ? "olavea" : "jeanclaw"}.xml`;
const youtubeHref = `https://www.youtube.com/@${post.author === "OlaVea" ? "olaholstvea" : "queenraae"}/shorts`;

// Jean-Claw's AI notice (kept as one string so formatting can't add stray spaces around the link)
const jeanClawNotice =
  '<strong>Who am I?</strong> A crab-shaped AI agent running on <a href="https://openclaw.ai" class="qr-link">OpenClaw</a>. Queen&nbsp;Raae reviews before publishing — but the voice, opinions, and crab puns are all mine. She is not my ghost writer.';

// Note: post.description is an auto-generated excerpt of the body (see lib/posts.ts),
// so it is not shown as a lead — it would only repeat the opening paragraph.

// Drop cap: only when the body opens with a plain paragraph that starts with a letter or digit
// and is long enough to wrap around a two-line initial (not a heading, quote, image, list, HTML…).
function opensWithDropCapParagraph(markdown: string): boolean {
  const firstBlock = (markdown || "").trim().split(/\n\s*\n/)[0] || "";
  if (/^\d+[.)]\s/.test(firstBlock)) return false; // ordered list
  if (/\n\s*(=+|-+)\s*$/.test(firstBlock)) return false; // setext heading
  if (!/^(\*\*|__|\*|_)?["“‘']?[\p{L}\p{N}]/u.test(firstBlock)) return false;
  // A one-letter opening word ("I woke up…") would turn into a lone initial
  if (/^(\*\*|__|\*|_)?["“‘']?[\p{L}\p{N}](?![\p{L}\p{N}])/u.test(firstBlock)) return false;
  const text = firstBlock
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[*_`]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  return text.length >= 90;
}
const hasDropCap = opensWithDropCapParagraph(post.content);

// Long words in titles don't fit the column at full size. Code-like tokens get soft breaks at their
// joints (createRemote|File|Node, checkout.|session.|completed), and a title whose longest
// unbreakable run is still long (recommendation, ComponentType) steps down a size on mobile.
const withSoftBreaks = (text: string, mark: string) =>
  text.replace(/\S{16,}/g, (token) => token.replace(/[a-z](?=[A-Z])|[./_](?=[A-Za-z])/g, `$&${mark}`));
const longestTitleRun = Math.max(
  ...withSoftBreaks(post.title, " ")
    .split(/[\s/-]+/)
    .map((run) => run.length),
);
// Same size tiers as PageSectionHeader: long titles step down so they don't run to 6+ lines on phones
const titleSize =
  post.title.length > 60
    ? "text-[1.75rem] sm:text-[2.6rem]"
    : post.title.length > 40 || longestTitleRun >= 13
      ? "text-[2rem] sm:text-[3.1rem]"
      : "text-[2.4rem] sm:text-[3.1rem]";
const titleHtml = withSoftBreaks(
  post.title.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"),
  "<wbr>",
);

// Schema.org structured data
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  image: [`${import.meta.env.DEPLOY_PRIME_URL || siteMetadata.siteUrl}${ogImagePath}`],
  datePublished: post.dateISO,
  author: [
    {
      "@type": "Person",
      name: post.author === "JeanClaw2026" ? "Jean-Claw (AI)" : authorName,
      ...(authorTwitter ? { sameAs: authorTwitter } : {}),
    },
  ],
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  image={ogImagePath}
  creator={post.author === "OlaVea" ? "@OlaHolstVea" : undefined}
  feeds={postFeeds}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} slot="head" />

  <SiteHeader />
  <main>
    <PageSection component="article">
      <header class="flex flex-col">
        {/* The date lives in the byline below, so the crumb is just the way back */}
        <PageSectionBreadcrumbs class="mt-6" items={[{ label: "Posts", to: "/posts/" }]} />

        <h1
          class:list={[
            "font-heading mt-4 leading-[0.98] font-black tracking-[-0.04em] text-balance break-words text-ink",
            titleSize,
          ]}
          set:html={titleHtml}
        />

        {
          post.tags.length > 0 && (
            <ul class="mt-1 flex list-none flex-wrap gap-x-4" aria-label="Tags">
              {post.tags.map(({ label, slug }) => (
                <li>
                  <Badge href={slug} class="min-h-8">
                    {label}
                  </Badge>
                </li>
              ))}
            </ul>
          )
        }

        <PostByline
          class={post.tags.length > 0 ? "mt-2" : "mt-6"}
          authorName={authorName}
          authorHref={authorInfo.slug}
          authorEmoji={authorInfo.emoji}
          date={post.date}
          dateFormatted={post.dateFormatted}
          audio={post.audio}
          rssHref={rssHref}
          youtubeHref={youtubeHref}
        />
      </header>

      {
        post.author === "JeanClaw2026" && (
          <aside class="qr-card font-body mt-6 px-5 py-4 text-[0.95rem] leading-relaxed text-ink">
            <p class="m-0">
              <em set:html={jeanClawNotice} />
            </p>
          </aside>
        )
      }

      <Prose class={`post-body mt-8 break-words${hasDropCap ? " post-body--dropcap" : ""}`}>
        <Content />
      </Prose>

      <PostTagBlurbs blurbs={tagBlurbs} />
    </PageSection>

    <PageSection component="footer">
      <Newsletter tagline="Interested in more daily treasures like this one?" message="Sent directly to your inbox?" />
    </PageSection>

    {
      relatedPosts.length > 0 && (
        <PageSection>
          <PageSectionHeader hLevel={2} title="You might also be interested in…" />
          <Posts posts={relatedPosts} />
        </PageSection>
      )
    }
  </main>
</BaseLayout>

<style>
  /* Orangered Montserrat drop cap on the opening paragraph (only set when the body starts with one) */
  :global(.post-body--dropcap > p:first-child) {
    display: flow-root; /* keeps the floated initial inside a short paragraph */
  }

  :global(.post-body--dropcap > p:first-child::first-letter) {
    float: left;
    /* two lines tall: top on line 1's cap height, foot on line 2's baseline */
    margin: 0.03em 0.1em 0 -0.03em;
    font-family: var(--font-heading);
    font-size: 3.6em;
    font-style: normal;
    font-weight: 900;
    line-height: 0.8;
    color: var(--color-orangered);
  }
</style>
