---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PageSection from "../components/PageSection.astro";
import PageSectionHeader from "../components/PageSectionHeader.astro";

const title = "5 Gatsby Gotchas to look out for as React developer";
---

<BaseLayout title={title}>
  <SiteHeader />
  <main>
    <!-- Header Section -->
    <PageSection component="header">
      <PageSectionHeader
        badge="Webinar"
        title={title}
        lead="A webinar on the common pitfalls React developers face when working with Gatsby for the first time."
        hLevel={1}
      />
    </PageSection>
  </main>
</BaseLayout>
