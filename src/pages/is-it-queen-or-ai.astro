---
import LogLayout from "../layouts/LogLayout.astro";
import TitleBlock from "../components/log/TitleBlock.astro";
import Divider from "../components/log/Divider.astro";
import QueenAiQuiz from "../components/QueenAiQuiz.astro";

const title = "Is it Queen or AI? Quiz";
const description =
  "Test your ability to distinguish between authentic Queen Raae quotes from her podcasts and AI-generated quotes that sound like her.";
const ogImage = "/og/is-it-queen-or-ai.png";
---

<LogLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt="Is it Queen or AI? — Queen Raae vs Jean-Claw quiz"
>
  <TitleBlock
    label="Quiz game"
    back={{ href: "/#treasures", label: "Treasures" }}
    lead="Can you tell the difference between real Queen Raae quotes and AI‑generated ones?"
  >
    Is it Queen or <span class="acid">AI</span>?
  </TitleBlock>

  <Divider />

  <section class="ruled gutter py-[clamp(24px,4vw,48px)]">
    <QueenAiQuiz />
  </section>
</LogLayout>
