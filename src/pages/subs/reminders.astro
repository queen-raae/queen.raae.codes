---
import LogLayout from "../../layouts/LogLayout.astro";
import TitleBlock from "../../components/log/TitleBlock.astro";
import Divider from "../../components/log/Divider.astro";
import NewsletterBlock from "../../components/log/NewsletterBlock.astro";
import ExtIcon from "../../components/log/ExtIcon.astro";
---

<LogLayout title="Live stream reminders" description="Live stream reminders" newsletter={false}>
  <TitleBlock label="Reminders">
    Live stream <span class="acid">reminders</span>.
    <p slot="after" class="lead m-0 max-w-[60ch] text-[clamp(18px,1.6vw,22px)] leading-normal">
      Get an email 30 minutes before I go live on the <a
        href="https://www.youtube.com/channel/UCDlrzlRdM1vGr8nO708KFmQ"
        target="_blank"
        rel="noopener">Queen Raae YouTube channel<ExtIcon /></a
      >. The YouTube notification system cannot be trusted.
    </p>
  </TitleBlock>
  <Divider />
  <NewsletterBlock formId="2816322" copy="One email, 30 minutes before the stream starts." cta="Remind me">
    <Fragment slot="title">Remind me <span class="acid">before</span>.</Fragment>
  </NewsletterBlock>
</LogLayout>
