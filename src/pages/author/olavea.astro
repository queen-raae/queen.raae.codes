---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import PageSection from "../../components/PageSection.astro";
import Newsletter from "../../components/Newsletter.astro";
import AuthorHeader from "../../components/listings/AuthorHeader.astro";
import PostArchive from "../../components/listings/PostArchive.astro";
import { getAllPosts, getAuthorInfo } from "../../lib/posts";

const AUTHOR = "OlaVea";
const NAME = "Ola Holst Vea";

// One source for the emoji, so the title, description, feed title and sigil can never drift apart
const { emoji = "" } = getAuthorInfo(AUTHOR);

const TITLE = `${NAME} ${emoji}`;
const DESCRIPTION = `${NAME} ${emoji} — Developer, tinkerer, and co-founder of Lilly Labs. Currently deep into Laravel. Follow his adventures on YouTube Shorts.`;

const allPosts = await getAllPosts();
const posts = allPosts.filter((post) => post.author === AUTHOR);
---

<BaseLayout
  title={TITLE}
  description={DESCRIPTION}
  image="/og/author/olavea.png"
  feeds={[{ title: `Posts by Cap'n Ola ${emoji}`, href: "/posts/olavea.xml" }]}
>
  <SiteHeader />
  <main>
    <PageSection component="section">
      <AuthorHeader
        name={NAME}
        emoji={emoji}
        rssHref="/posts/olavea.xml"
        youtubeHref="https://www.youtube.com/@olaholstvea/shorts"
      >
        Developer, tinkerer, and co-founder of Lilly Labs. Currently deep into Laravel.
      </AuthorHeader>
      <PostArchive posts={posts} label={`Posts by ${NAME}`} />
    </PageSection>

    <PageSection component="footer">
      <Newsletter />
    </PageSection>
  </main>
</BaseLayout>
