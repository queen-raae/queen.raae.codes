---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import PageSection from "../../components/PageSection.astro";
import Newsletter from "../../components/Newsletter.astro";
import AuthorHeader from "../../components/listings/AuthorHeader.astro";
import PostArchive from "../../components/listings/PostArchive.astro";
import { getAllPosts, getAuthorInfo } from "../../lib/posts";

const AUTHOR = "Queen";
const NAME = "Queen Raae";

// One source for the emoji, so the title, description, feed title and sigil can never drift apart
const { emoji = "" } = getAuthorInfo(AUTHOR);

const TITLE = `${NAME} ${emoji}`;
const DESCRIPTION = `${NAME} ${emoji} — Norwegian developer, builder, speaker, and pirate queen. She builds products in public and runs Lilly Labs with her family. She writes about web development, AI, and the adventures of running a family business.`;

const allPosts = await getAllPosts();
const posts = allPosts.filter((post) => post.author === AUTHOR);
---

<BaseLayout
  title={TITLE}
  description={DESCRIPTION}
  image="/og/author/queen.png"
  feeds={[{ title: `Posts by Queen Raae ${emoji}`, href: "/posts/queen.xml" }]}
>
  <SiteHeader />
  <main>
    <PageSection component="section">
      <AuthorHeader
        name={NAME}
        emoji={emoji}
        rssHref="/posts/queen.xml"
        youtubeHref="https://www.youtube.com/@queenraae/shorts"
      >
        Norwegian developer, builder, speaker, and pirate queen. She builds products in public and runs Lilly Labs with
        her family. She writes about web development, AI, and the adventures of running a family business.
      </AuthorHeader>
      <PostArchive posts={posts} label={`Posts by ${NAME}`} />
    </PageSection>

    <PageSection component="footer">
      <Newsletter />
    </PageSection>
  </main>
</BaseLayout>
