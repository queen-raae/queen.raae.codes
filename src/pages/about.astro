---
import LogLayout from "../layouts/LogLayout.astro";
import PersonJsonLd from "../components/log/PersonJsonLd.astro";
import TitleBlock from "../components/log/TitleBlock.astro";
import Divider from "../components/log/Divider.astro";
import { getEntry } from "astro:content";

// Get about page content
const about = await getEntry("landing", "about");
const { Content } = await about.render();
---

<LogLayout
  title={about.data.title}
  description="Queen Raae is Benedicte Raae, a developer in Oslo and co-captain of Lilly Labs."
>
  <PersonJsonLd slot="head" />
  <TitleBlock label="About">
    Hi, I’m <span class="acid">Queen Raae</span>.
  </TitleBlock>
  <Divider />
  <article class="ruled py-[clamp(32px,4vw,56px)]">
    <div class="log-prose">
      <Content />
    </div>
  </article>
</LogLayout>
