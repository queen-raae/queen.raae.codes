---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PageSection from "../components/PageSection.astro";
import PageSectionHeader from "../components/PageSectionHeader.astro";
import Prose from "../components/Prose.astro";
import { getEntry } from "astro:content";

// Get about page content
const about = await getEntry("landing", "about");
const { Content } = await about.render();

const { badge, title } = about.data;
---

<BaseLayout title={title}>
  <SiteHeader />
  <main>
    <!-- About Section -->
    <PageSection component="header">
      <PageSectionHeader badge={badge} />
      <!-- The content opens with its own greeting, styled as the headline below; the h1 is for screen readers -->
      <h1 class="sr-only">{title || "About"}</h1>
      <Prose class="about-prose mt-4">
        <Content />
      </Prose>
    </PageSection>
  </main>
</BaseLayout>

<style is:global>
  /* "🖐️ Hi, I'm Queen Raae." — a lone bold line opening the content becomes the visual headline */
  .about-prose > p:first-child:has(> strong:only-child) {
    margin-bottom: 1.5rem;
  }
  .about-prose > p:first-child > strong:only-child {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  @media (min-width: 40rem) {
    .about-prose > p:first-child > strong:only-child {
      font-size: 3.1rem;
    }
  }
  /* Photo: square corners, 2px ink edge (static, so no shadow) */
  .about-prose img {
    border: 2px solid var(--color-ink);
  }
  /* The photo closes the page; its prose margin shouldn't add to the gap above the footer */
  .about-prose > p:last-child > img {
    margin-bottom: 0;
  }
</style>
