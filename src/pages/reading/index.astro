---
import LogLayout from "../../layouts/LogLayout.astro";
import TitleBlock from "../../components/log/TitleBlock.astro";
import Divider from "../../components/log/Divider.astro";
import SectionBar from "../../components/log/SectionBar.astro";
import TypeLabel from "../../components/log/TypeLabel.astro";
import Shelf from "../../components/log/Shelf.astro";
import { getReadingItems, type ReadingItem } from "../../lib/reading";

const TITLE = "Reading";
const DESCRIPTION = "Short notes on the books and articles Queen Raae has read, written the day she finished them.";

const items = await getReadingItems();
const books = items.filter((item) => item.kind === "Book");
const articles = items.filter((item) => item.kind === "Article");
const episodes = items.filter((item) => item.kind === "Episode");
const hasStandIns = items.some((item) => item.standIn);

const years = new Map<string, ReadingItem[]>();
items.forEach((item) => {
  if (!years.has(item.year)) years.set(item.year, []);
  years.get(item.year)!.push(item);
});

const pad = (n: number) => String(n).padStart(2, "0");
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const summary = (list: ReadingItem[]) =>
  [
    plural(list.length, "note"),
    plural(list.filter((i) => i.kind === "Book").length, "book"),
    plural(list.filter((i) => i.kind === "Article").length, "article"),
  ].join(" · ");

const filters = [
  { key: "all", label: "All", show: true },
  { key: "book", label: "Books", show: books.length > 0 },
  { key: "article", label: "Articles", show: articles.length > 0 },
  { key: "reread", label: "Re‑reads", show: items.some((i) => i.reread) },
  { key: "episode", label: "Episodes", show: episodes.length > 0 },
].filter((f) => f.show);
---

<LogLayout title={TITLE} description={DESCRIPTION}>
  <TitleBlock
    label="Reading"
    lead="Short notes on books and articles, written the day I finish and not a day later. Not reviews; what I’d tell you over coffee if we had four minutes. Newest first, grouped by year."
  >
    What I’ve read, and the <span class="acid">two sentences</span> I kept.
    <nav slot="after" aria-label="Filter" class="reading-filter flex items-center gap-x-1 flex-wrap -ml-2.5">
      <span class="mono text-panel px-2.5">Show</span>
      {
        filters.map((filter, index) => (
          <Fragment>
            {index > 0 && (
              <span class="mono text-panel" aria-hidden="true">
                ·
              </span>
            )}
            <a
              class="navlink"
              href={`#${filter.key}`}
              data-filter={filter.key}
              aria-current={filter.key === "all" ? "page" : undefined}
            >
              {filter.label}
            </a>
          </Fragment>
        ))
      }
      <span class="mono text-panel px-2.5 ml-auto">{summary(items)}</span>
    </nav>
  </TitleBlock>

  <Divider glyph="slashes" />

  {
    hasStandIns && (
      <p class="mono ruled gutter py-3 m-0 bg-panel">
        Preview only: these are the stand-in books from the mock-ups. They disappear as soon as the first real Book
        entry exists, and never show in production.
      </p>
    )
  }

  {
    books.length > 0 && (
      <section id="shelf" class="ruled flex flex-col">
        <SectionBar num="01" title="On the shelf" note="· the latest books" />
        <Shelf books={books.slice(0, 5)} />
      </section>
    )
  }

  {
    items.length === 0 && (
      <section class="ruled gutter py-[clamp(32px,4vw,56px)]">
        <p class="m-0 max-w-[60ch] text-[19px]">
          Nothing on the shelf yet. The first notes land here as soon as they’re written.
        </p>
      </section>
    )
  }

  {
    [...years.entries()].map(([year, list], index) => (
      <section id={`y${year}`} class="reading-year ruled flex flex-col">
        <SectionBar num={pad(index + (books.length > 0 ? 2 : 1))} title={year}>
          <span class="mono">{summary(list)}</span>
        </SectionBar>
        {list.map((item) => (
          <a
            class="row"
            href={item.href}
            data-kind={item.kind.toLowerCase()}
            data-reread={item.reread ? "true" : undefined}
          >
            <span class="mono row-date basis-20!">{item.dateShort}</span>
            <TypeLabel type={item.kind === "Episode" ? "Podcast" : item.kind} class="row-type" />
            <span class="row-main">
              <span class="flex items-baseline gap-x-3.5 gap-y-1.5 flex-wrap">
                <span class="ttl">
                  {item.kind === "Book" && (
                    <svg class="inline-block -mb-px mr-2" width="14" height="18" viewBox="0 0 14 18" aria-hidden="true">
                      <path
                        d="M1 1h12v16l-6-4.5L1 17z"
                        fill="#FBBF24"
                        stroke="#3D1230"
                        stroke-width="2"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                  {item.title}
                </span>
                {item.creator && <span class="mono row-by">{item.creator}</span>}
                {item.reread && (
                  <span class="mono inline-block border-2 border-ink px-1.5 py-px font-bold text-[11px]! leading-[1.4]">
                    re‑read
                  </span>
                )}
              </span>
              <span class="row-desc">{item.note}</span>
            </span>
          </a>
        ))}
      </section>
    ))
  }
</LogLayout>

<script>
  // Filter the notes in place; without JS every note simply shows.
  const links = document.querySelectorAll<HTMLAnchorElement>(".reading-filter [data-filter]");

  const apply = (key: string) => {
    links.forEach((link) => link.toggleAttribute("aria-current", link.dataset.filter === key));
    if (links.length) {
      document.querySelectorAll<HTMLElement>(".reading-filter [aria-current]").forEach((el) => {
        el.setAttribute("aria-current", "page");
      });
    }

    document.querySelectorAll<HTMLElement>(".reading-year").forEach((section) => {
      let visible = 0;
      section.querySelectorAll<HTMLElement>("[data-kind]").forEach((row) => {
        const show = key === "all" || (key === "reread" ? row.dataset.reread === "true" : row.dataset.kind === key);
        row.hidden = !show;
        if (show) visible++;
      });
      section.hidden = visible === 0;
    });
  };

  links.forEach((link) =>
    link.addEventListener("click", (event) => {
      event.preventDefault();
      const key = link.dataset.filter || "all";
      history.replaceState(null, "", key === "all" ? location.pathname : `#${key}`);
      apply(key);
    }),
  );

  const initial = location.hash.slice(1);
  if ([...links].some((link) => link.dataset.filter === initial)) apply(initial);
</script>
