---
import { Image } from "astro:assets";
import LogLayout from "../layouts/LogLayout.astro";
import TitleBlock from "../components/log/TitleBlock.astro";
import Divider from "../components/log/Divider.astro";
import { OG_PAGES, getOgPageImage } from "../data/og-pages";
import { getAllPosts } from "../lib/posts";

// Small joys are log entries with type: Joy. Photo, words (the body), place and title are all optional.
const { title: TITLE, description: DESCRIPTION } = OG_PAGES["small-joys"];
const joys = await Promise.all(
  (await getAllPosts())
    .filter((post) => post.type === "Joy")
    .map(async (post) => ({ post, Content: (await post.render()).Content })),
);
---

<LogLayout title={TITLE} description={DESCRIPTION} image={getOgPageImage("small-joys")}>
  <TitleBlock>Small <span class="acid">joys</span>.</TitleBlock>

  <section class="joys-wall ruled gutter">
    {
      joys.map(({ post, Content }) => {
        // A title she wrote herself shows as words; the fallback (place or "Small joy") doesn't
        const ownTitle = post.titleText !== post.place && post.titleText !== "Small joy" ? post.titleText : undefined;
        const hasWords = !!ownTitle || post.wordCount > 0;
        return (
          <figure class:list={["joys-photo", !post.photo && "joys-photo--text"]}>
            {post.photo && (
              <a href={post.slug} class="joys-shot" aria-label={post.title}>
                <Image
                  src={post.photo}
                  alt={post.photoAlt ?? ""}
                  widths={[400, 800, Math.min(post.photo.width, 1200)]}
                  sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw"
                />
              </a>
            )}
            <figcaption class="joys-label">
              {hasWords && (
                <div class="joys-words">
                  {ownTitle && <p class="joys-title">{ownTitle}</p>}
                  {post.wordCount > 0 && <Content />}
                </div>
              )}
              <a href={post.slug} class="mono joys-meta">
                <time datetime={post.date}>{post.dateLong}</time>
                {post.place && <> · {post.place}</>}
              </a>
            </figcaption>
          </figure>
        );
      })
    }
  </section>

  <Divider />
</LogLayout>
