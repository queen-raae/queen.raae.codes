---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PageSection from "../components/PageSection.astro";
import PageSectionHeader from "../components/PageSectionHeader.astro";
import Prose from "../components/Prose.astro";
import Posts from "../components/Posts.astro";
import CtaButton from "../components/CtaButton.astro";
import Newsletter from "../components/Newsletter.astro";
import FeaturedPost from "../components/home/FeaturedPost.astro";
import TreasureCard from "../components/home/TreasureCard.astro";
import { getAllPosts } from "../lib/posts";
import { getEntry } from "astro:content";

// Get landing page content
const landing = await getEntry("landing", "index");
const { Content } = await landing.render();

// Latest posts (5 only): the newest is featured, the next four are listed
const allPosts = await getAllPosts();
const [featuredPost, ...latestPosts] = allPosts.slice(0, 5);

// Treasures
const treasures = [
  {
    title: "Book Me as a Speaker",
    to: "/speaker/",
    kicker: "Joyful AI Talks for Devs & Non-Techies",
    by: "with",
    name: "Queen Raae",
    emoji: "👑",
    spark: true,
  },
  {
    title: "Is it Queen or AI?",
    to: "/is-it-queen-or-ai/",
    kicker: "Quiz Game",
    by: "by",
    name: "Jean-Claw",
    emoji: "🦀",
  },
  {
    title: "POW! — The Privacy-First Menstrual Cycle Journal",
    href: "https://usepow.app",
    kicker: "Side Project",
    by: "by",
    name: "Queen Raae",
    emoji: "👑",
  },
  {
    title: "Slow & Steady Podcast",
    href: "https://slowandsteadypodcast.com/",
    kicker: "Podcast",
    by: "by",
    name: "Benedikt Deicke",
    emoji: "🎙️",
  },
];

const { badge, title } = landing.data;

// Two columns on desktop: a flexible main column and a newsletter-wide side column
const columns = "lg:grid-cols-[minmax(0,1fr)_var(--container-sm)]";
---

<BaseLayout title={title}>
  <SiteHeader />
  <main class="pb-12">
    <PageSection component="div" width="wide">
      <!-- Welcome + newsletter -->
      <header class:list={["grid gap-8 pt-6 lg:items-end lg:gap-12", columns]}>
        <div>
          {badge && <p class="qr-label m-0 text-plum-400">{badge}</p>}
          <h1
            class="font-heading mt-4 mb-0 text-[2.75rem] leading-[0.92] font-black tracking-[-0.04em] text-balance text-ink sm:text-[3.5rem] xl:text-[4.25rem]"
          >
            {title}
          </h1>
          <Prose
            class="mt-6 prose-a:font-semibold [&>p:first-child]:text-xl [&>p:first-child]:leading-snug [&>p:first-child]:text-pretty [&>p:first-child]:text-plum-500 [&>p:first-child]:italic"
          >
            <Content />
          </Prose>
        </div>

        <Newsletter />
      </header>

      <hr class="ornamental-hr" />

      <div class="flex flex-col gap-12">
        {featuredPost && <FeaturedPost post={featuredPost} />}

        <div class:list={["grid gap-12", columns]}>
          <section>
            <PageSectionHeader title="Latest Posts" />
            <Posts posts={latestPosts} numbered />
            <CtaButton to="/posts/" class="mt-10 flex">Read all posts</CtaButton>
          </section>

          <section>
            <PageSectionHeader title="Treasures" />
            <ul class="m-0 flex list-none flex-col gap-6 p-0">
              {
                treasures.map((treasure) => (
                  <li>
                    <TreasureCard {...treasure} />
                  </li>
                ))
              }
            </ul>
            <CtaButton to="/speaker/" class="mt-10 flex">See all talks</CtaButton>
          </section>
        </div>
      </div>
    </PageSection>
  </main>
</BaseLayout>
