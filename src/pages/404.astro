---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PageSection from "../components/PageSection.astro";
import PageSectionHeader from "../components/PageSectionHeader.astro";
---

<BaseLayout title="Page Not Found" description="This page doesn't exist — but the treasure is elsewhere!">
  <SiteHeader />
  <main>
    <PageSection component="header">
      <PageSectionHeader
        badge="404"
        title="This page has sailed off the map 🗺️"
        lead="The treasure you're looking for might be elsewhere…"
        hLevel={1}
      />

      <div class="mt-6">
        <img
          src="https://media.giphy.com/media/8P8u3gh2OJqog/giphy.gif"
          alt="Confused pirate looking around"
          width="480"
          height="266"
          class="block h-auto max-w-full border-2 border-ink bg-paper"
          loading="eager"
        />
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="qr-btn qr-btn--primary">Back to shore 👑</a>
        <a href="/search/" class="qr-btn">Search for treasure 🔍</a>
      </div>
    </PageSection>
  </main>
</BaseLayout>
