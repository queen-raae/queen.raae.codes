---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import PageSection from "../../components/PageSection.astro";
import PageSectionHeader from "../../components/PageSectionHeader.astro";
import Newsletter from "../../components/Newsletter.astro";
import PageLinks from "../../components/PageLinks.astro";
import PostArchive from "../../components/listings/PostArchive.astro";
import { getAllPosts } from "../../lib/posts";

const BADGE = "Posts";
const TITLE = "All the posts";
const DESCRIPTION = "Posts from sailing the high seas of the World Wide Web.";

const allPosts = await getAllPosts();
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <SiteHeader />
  <main>
    <PageSection component="section">
      <PageSectionHeader badge={BADGE} title={TITLE} lead={DESCRIPTION} hLevel={1} />
      <PageLinks rssHref="/posts/rss.xml" />
      <PostArchive posts={allPosts} label="All posts" />
    </PageSection>

    <PageSection component="footer">
      <Newsletter />
    </PageSection>
  </main>
</BaseLayout>
