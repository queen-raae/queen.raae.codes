---
import LogLayout from "../../layouts/LogLayout.astro";
import { OG_PAGES, getOgPageImage } from "../../data/og-pages";
import TitleBlock from "../../components/log/TitleBlock.astro";
import Divider from "../../components/log/Divider.astro";
import SectionBar from "../../components/log/SectionBar.astro";
import YearSections from "../../components/log/YearSections.astro";
import { getAllPosts, groupByYear } from "../../lib/posts";

const { title: TITLE, description: DESCRIPTION } = OG_PAGES.posts;

const allPosts = await getAllPosts();
const years = groupByYear(allPosts);

// Density strip runs oldest → newest, including empty years
const counts = new Map(years.map(({ year, posts }) => [year, posts.length]));
const first = Number(years[years.length - 1]?.year);
const last = Number(years[0]?.year);
const strip = Array.from({ length: last - first + 1 }, (_, i) => {
  const year = String(first + i);
  return { year, count: counts.get(year) ?? 0 };
});
const max = Math.max(...strip.map((s) => s.count));
const busiest = strip.find((s) => s.count === max)?.year;
---

<LogLayout
  title={TITLE}
  description={DESCRIPTION}
  image={getOgPageImage("posts")}
  feeds={[{ title: "Queen Raae's log", href: "/posts/queen.xml" }]}
>
  <TitleBlock
    label="The archive"
    lead={`Every entry since ${first}, newest first. The early ones are rough. They stay.`}
  >
    Everything, <span class="acid">by year</span>.
    <nav slot="after" id="years" aria-label="Jump to a year" class="flex flex-wrap gap-1.5 pt-1 scroll-mt-4">
      {
        years.map(({ year }, index) => (
          <a class="chip" href={`#y${year}`} aria-current={index === 0 ? "true" : undefined}>
            {year}
          </a>
        ))
      }
    </nav>
  </TitleBlock>

  <Divider />

  <section id="density" class="ruled flex flex-col">
    <SectionBar num="01" title="Entries per year">
      <span class="mono max-[560px]:hidden">{allPosts.length} entries · {first} → {last} · busiest year {busiest}</span>
      <a class="navlink" href="/posts/queen.xml" aria-label="RSS feed">RSS</a>
    </SectionBar>
    <div class="overflow-x-auto gutter py-5 box-border">
      <div class="density">
        {
          strip.map(({ year, count }) =>
            count > 0 ? (
              <a class="col" href={`#y${year}`} aria-label={`${year}, ${count} entries`}>
                <span class="n">{count}</span>
                <span class="b" style={`height:${Math.max(4, Math.round((count / max) * 128))}px`} />
                <span class="y">{year}</span>
              </a>
            ) : (
              <span class="col" aria-label={`${year}, no entries`}>
                <span class="n">0</span>
                <span class="b" style="height:0" />
                <span class="y">{year}</span>
              </span>
            ),
          )
        }
      </div>
    </div>
  </section>

  <YearSections posts={allPosts} startAt={2} jumpTo="#years" />
</LogLayout>
