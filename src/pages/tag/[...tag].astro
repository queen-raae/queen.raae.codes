---
import LogLayout from "../../layouts/LogLayout.astro";
import TitleBlock from "../../components/log/TitleBlock.astro";
import Divider from "../../components/log/Divider.astro";
import YearSections from "../../components/log/YearSections.astro";
import ExtIcon from "../../components/log/ExtIcon.astro";
import { getAllTags } from "../../lib/posts";
import { getTagBlurbs } from "../../lib/tag-blurbs";
import { getTagOgDescription, getTagOgImageUrl } from "../../lib/og-image";

export async function getStaticPaths() {
  const tagsMap = await getAllTags();

  return Array.from(tagsMap.entries()).map(([slug, { label, posts }]) => {
    // Remove /tag/ prefix and trailing slash
    const tagParam = slug.replace(/^\/tag\//, "").replace(/\/$/, "");
    return {
      params: { tag: tagParam },
      props: { label, posts },
    };
  });
}

const { label, posts } = Astro.props;

const blurbMap = await getTagBlurbs();
const blurb = blurbMap.get(label);

const title = `Entries tagged #${label}`;
const description = getTagOgDescription(label, blurb?.description);
const ogImage = getTagOgImageUrl(Astro.params.tag!, label, description);
const feedHref = `/posts/${Astro.params.tag}.xml`;
---

<LogLayout
  title={title}
  description={description}
  image={ogImage}
  feeds={[{ title: `Posts tagged #${label}`, href: feedHref }]}
>
  <TitleBlock back={{ href: "/posts/", label: "The log" }} size="small">
    <Fragment slot="meta">
      <span class="label">Tag</span>
      <span>{posts.length} {posts.length === 1 ? "entry" : "entries"}</span>
      <a class="navlink" href={feedHref}>RSS</a>
    </Fragment>
    <span class="text-amber-500">#</span>{label}
    <Fragment slot="after">
      {
        blurb && (blurb.description || blurb.disclaimer || blurb.url) && (
          <p class="lead m-0 max-w-[60ch] text-[clamp(18px,1.6vw,22px)] leading-normal">
            <strong>{blurb.displayName || label}</strong>
            {blurb.description && <span> — {blurb.description}</span>}
            {blurb.disclaimer && <span> {blurb.disclaimer}</span>}{" "}
            {blurb.url && (
              <a href={blurb.url} target="_blank" rel="noopener">
                {blurb.url.replace(/^https?:\/\//, "")}
                <ExtIcon />
              </a>
            )}
          </p>
        )
      }
    </Fragment>
  </TitleBlock>
  <Divider />
  <YearSections posts={posts} />
</LogLayout>
