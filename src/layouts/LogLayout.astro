---
import BaseLayout from "./BaseLayout.astro";
import LogHeader from "../components/log/LogHeader.astro";
import LogFooter from "../components/log/LogFooter.astro";
import NewsletterBlock from "../components/log/NewsletterBlock.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  creator?: string;
  canonical?: string;
  feeds?: { title: string; href: string }[];
  newsletter?: boolean;
}

const { newsletter = true, ...baseProps } = Astro.props;
---

<BaseLayout {...baseProps}>
  <slot name="head" slot="head" />
  <div class="log-page">
    <div class="log-frame">
      <LogHeader />
      <main>
        <slot />
      </main>
      {newsletter && <NewsletterBlock />}
      <LogFooter />
    </div>
  </div>
</BaseLayout>
