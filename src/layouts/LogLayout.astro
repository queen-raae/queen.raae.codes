---
import BaseLayout from "./BaseLayout.astro";
import LogHeader from "../components/log/LogHeader.astro";
import LogFooter from "../components/log/LogFooter.astro";
import NewsletterBlock from "../components/log/NewsletterBlock.astro";
import SearchOverlay from "../components/log/SearchOverlay.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  creator?: string;
  canonical?: string;
  feeds?: { title: string; href: string }[];
  lang?: string;
  article?: { publishedTime: string; author?: string; tags?: string[] };
  newsletter?: boolean;
  /** Log entry page: on phones the entry strip under the header stands in for the menu row */
  entry?: boolean;
}

const { newsletter = true, entry = false, ...baseProps } = Astro.props;
---

<BaseLayout {...baseProps}>
  <slot name="head" slot="head" />
  <div class="log-page">
    <div class="log-frame">
      <LogHeader entry={entry} />
      <main>
        <slot />
      </main>
      {newsletter && <NewsletterBlock />}
      <LogFooter />
    </div>
  </div>
  <SearchOverlay />
</BaseLayout>
