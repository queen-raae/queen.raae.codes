---
import siteMetadata from "../data/siteMetadata.js";
// Fonts are self-hosted (Fontsource) so no visitor data goes to Google
// and the site doesn't depend on an outside font service.
import "@fontsource/archivo-black/400.css";
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/600.css";
import "@fontsource/archivo/700.css";
import "@fontsource/montserrat/600.css";
import "@fontsource/lora/400.css";
import "@fontsource/lora/500.css";
import "@fontsource/lora/600.css";
import "@fontsource/lora/700.css";
import "@fontsource/lora/400-italic.css";
import "@fontsource/lora/500-italic.css";
import "@fontsource/lora/600-italic.css";
import "@fontsource/lora/700-italic.css";
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";
import "../global.css";
// Preload the faces every page shows above the fold, so the browser fetches
// them alongside the CSS instead of after it.
import archivoBlack from "@fontsource/archivo-black/files/archivo-black-latin-400-normal.woff2?url";
import archivoBold from "@fontsource/archivo/files/archivo-latin-700-normal.woff2?url";
import lora from "@fontsource/lora/files/lora-latin-400-normal.woff2?url";
import spaceMono from "@fontsource/space-mono/files/space-mono-latin-400-normal.woff2?url";
import spaceMonoBold from "@fontsource/space-mono/files/space-mono-latin-700-normal.woff2?url";

const preloadFonts = [archivoBlack, archivoBold, lora, spaceMono, spaceMonoBold];

interface RssFeed {
  title: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  creator?: string;
  canonical?: string;
  feeds?: RssFeed[];
  lang?: string;
  article?: { publishedTime: string; author?: string; tags?: string[] };
  children?: any;
}

const {
  title,
  description,
  image,
  imageAlt,
  type = "website",
  creator,
  canonical: canonicalProp,
  feeds = [],
  lang = "en",
  article,
} = Astro.props;

// Always include the main feed, plus any page-specific feeds
const allFeeds: RssFeed[] = [{ title: "All Posts — Queen Raae & Family", href: "/posts/rss.xml" }, ...feeds];

const { siteName, siteTagline, siteDescription, siteUrl, siteSocialImage, siteSocialImageAlt, siteTwitterCreator } =
  siteMetadata;

const deployUrl =
  import.meta.env.CONTEXT === "production"
    ? import.meta.env.URL || siteUrl
    : import.meta.env.DEPLOY_PRIME_URL || siteUrl;
const siteTitle = `${siteName} — ${siteTagline}`;
const pageTitle = title ? `${title}  —  ${siteName}` : siteTitle;
const pageImage = image || siteSocialImage;
const pageDescription = description || siteDescription;
const canonical = canonicalProp || `${siteUrl}${Astro.url.pathname}`;
const socialType = type;
const socialTitle = pageTitle;
const socialImage = pageImage && `${deployUrl}${pageImage}`;
// Generated cards show the page title, so it doubles as their alt text
const socialImageAlt = image ? imageAlt || title || siteTitle : siteSocialImageAlt;
const socialLocale = lang === "no" ? "nb_NO" : "en_US";
const socialDescription = pageDescription;
const twitterSite = siteTwitterCreator;
const twitterCreator = creator || siteTwitterCreator;
const twitterCard = "summary_large_image";
// Generated cards are all 1200x628; declaring it helps Slack and friends pick the large preview
const socialImageIsCard = pageImage?.startsWith("/og/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3D1230" />

    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>👑</text></svg>"
    />

    <meta name="description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content={socialType} />
    <meta property="og:locale" content={socialLocale} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImageIsCard && <meta property="og:image:type" content="image/png" />}
    {socialImageIsCard && <meta property="og:image:width" content="1200" />}
    {socialImageIsCard && <meta property="og:image:height" content="628" />}
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content={twitterSite} />
    <meta name="twitter:creator" content={twitterCreator} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}

    {allFeeds.map((feed) => <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />)}

    <!-- Fathom Analytics -->
    <script
      src="https://cdn.usefathom.com/script.js"
      data-site="DIFBAEOT"
      data-included-domains="queen.raae.codes"
      defer></script>

    <slot name="head" />

    <script type="module" is:inline>
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
      mermaid.initialize({ startOnLoad: false, theme: "default" });

      document.querySelectorAll("pre[data-language='mermaid']").forEach((pre) => {
        const content = pre.querySelector("code").textContent;
        const div = document.createElement("div");
        div.className = "mermaid";
        div.textContent = content;
        pre.replaceWith(div);
      });

      mermaid.run();
    </script>
  </head>
  <body class="log-body">
    <slot />
  </body>
</html>
