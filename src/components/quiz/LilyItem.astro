---
// A list item with a deep-gold lily marker and a hanging indent (wrapped lines align with the text).
// Use inside <ul class="m-0 flex list-none flex-col gap-2 p-0">.
---

<li class="flex items-baseline gap-2.5">
  <span class="qr-lily shrink-0 text-gold-deep" aria-hidden="true"></span>
  <span><slot /></span>
</li>
