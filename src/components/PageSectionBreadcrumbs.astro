---
interface BreadcrumbItem {
  label: string;
  to?: string;
  datetime?: string;
}

interface Props {
  items?: BreadcrumbItem[];
  class?: string;
}

const { items = [], class: className } = Astro.props;
---

<nav aria-label="breadcrumb" class:list={["qr-label", className]}>
  {
    items.map(({ label, to, datetime }, index) => {
      const isLast = index + 1 === items.length;

      if (to) {
        return (
          <a
            href={to}
            class:list={["inline-block leading-none no-underline group", isLast ? "text-ink" : "text-plum-500"]}
          >
            <span class="decoration-orangered decoration-2 underline-offset-4 group-hover:underline">{label}</span>
            {!isLast && (
              <span aria-hidden="true" class="px-2 text-gold-deep">
                /
              </span>
            )}
          </a>
        );
      }

      return (
        <span class:list={["inline-block leading-none", isLast ? "text-ink" : "text-plum-500"]}>
          {datetime ? <time datetime={datetime}>{label}</time> : <span>{label}</span>}
          {!isLast && (
            <span aria-hidden="true" class="px-2 text-gold-deep">
              /
            </span>
          )}
        </span>
      );
    })
  }
</nav>
