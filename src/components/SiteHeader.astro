---
type NavKey = "posts" | "speaker" | "about";

interface Props {
  current?: NavKey | null;
}

const path = Astro.url.pathname;

function detectCurrent(pathname: string): NavKey | null {
  if (/^\/(posts|tag|author)\//.test(pathname) || /^\/\d{4}-\d{2}-\d{2}-/.test(pathname)) return "posts";
  if (pathname.startsWith("/speaker")) return "speaker";
  if (pathname.startsWith("/about")) return "about";
  return null;
}

const current = Astro.props.current === undefined ? detectCurrent(path) : Astro.props.current;

const links: { key: NavKey; label: string; href: string }[] = [
  { key: "posts", label: "Posts", href: "/posts/" },
  { key: "speaker", label: "Speaker", href: "/speaker/" },
  { key: "about", label: "About", href: "/about/" },
];
---

<header class="border-t-8 border-orangered bg-cream px-4 sm:px-6">
  <!-- Below 360px the gaps shrink so the crown, three links and search still fit on one row -->
  <div class="mx-auto flex max-w-6xl items-center gap-0 py-2.5 min-[360px]:gap-1 sm:gap-4">
    <a
      href="/"
      class="mr-auto -ml-1 shrink-0 px-1 py-1.5 text-[1.75rem] leading-none no-underline transition-transform hover:scale-110"
      aria-label="Queen Raae, home"
    >
      <span aria-hidden="true">👑</span>
    </a>

    <nav aria-label="Main">
      <ul class="m-0 flex list-none items-center gap-0.5 p-0 sm:gap-1">
        {
          links.map(({ key, label, href }) => (
            <li>
              <a
                href={href}
                aria-current={current === key ? "page" : undefined}
                class:list={[
                  "qr-label block border-b-4 px-1 pt-3 pb-2 text-ink no-underline transition-colors hover:bg-gold min-[360px]:px-1.5 sm:px-3",
                  current === key ? "border-orangered" : "border-transparent",
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/search/" class="qr-icon-btn ml-0 shrink-0 min-[360px]:ml-1" aria-label="Search">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="M15.5 15.5L21 21"></path>
      </svg>
    </a>
  </div>
</header>
