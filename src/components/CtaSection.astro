---
import CtaButton from "./CtaButton.astro";

interface Props {
  href?: string;
  to?: string;
  label?: string;
  note?: string;
  noteTitle?: string;
  class?: string;
  /** Passed through to CtaButton: secondary (default), primary, or cta (max one per page) */
  variant?: "secondary" | "primary" | "cta";
}

const { href, to, label, note, noteTitle, class: className, variant } = Astro.props;
---

{
  label && (href || to) && (
    <div class={className}>
      <CtaButton href={href} to={to} variant={variant}>
        {label}
      </CtaButton>

      {noteTitle && <p class="qr-label mt-4 mb-1 text-ink">{noteTitle}</p>}
      {note && (
        <p class:list={["font-body mb-0 text-[0.95rem] text-plum-500 italic", noteTitle ? "mt-1" : "mt-3"]}>{note}</p>
      )}
    </div>
  )
}
