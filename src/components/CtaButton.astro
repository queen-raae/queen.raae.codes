---
interface Props {
  href?: string;
  to?: string;
  class?: string;
  /** secondary = paper (default), primary = plum, cta = the one orangered button per page */
  variant?: "secondary" | "primary" | "cta";
}

const { href, to, class: className, variant = "secondary" } = Astro.props;

const linkHref = to || href;
const isMailto = href?.startsWith("mailto:");
const isExternal = Boolean(href) && !isMailto;
---

<a
  href={linkHref}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noreferrer" : undefined}
  class:list={[
    "qr-btn justify-between max-sm:w-full",
    variant === "primary" && "qr-btn--primary",
    variant === "cta" && "qr-btn--cta",
    className,
  ]}
>
  <span><slot /></span>
  {isExternal && <span aria-hidden="true">↗</span>}
  {to && <span aria-hidden="true">→</span>}
</a>
