---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;

const baseClasses = [
  "qr-label inline-flex items-center no-underline text-plum-500 transition-colors",
  "hover:text-ember",
];
---

{
  href ? (
    <a href={href} class:list={[...baseClasses, className]}>
      <>
        <span class="text-gold-deep">#</span>
        <slot />
      </>
    </a>
  ) : (
    <span class:list={[...baseClasses, className]}>
      <>
        <span class="text-gold-deep">#</span>
        <slot />
      </>
    </span>
  )
}
