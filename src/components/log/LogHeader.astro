---
const path = Astro.url.pathname;

const links = [
  { label: "Log", href: "/posts/", match: (p: string) => p.startsWith("/posts/") || p.startsWith("/tag/") },
  { label: "About", href: "/about/", match: (p: string) => p.startsWith("/about/") },
];
---

<header class="ruled gutter flex items-center justify-between gap-x-6 gap-y-2 flex-wrap py-2.5">
  <a
    href="/"
    class="inline-flex items-center min-h-11 pr-2 text-[28px] leading-none no-underline! hover:bg-transparent!"
  >
    <span aria-hidden="true">👑</span>
    <span class="sr-only-log">Queen Raae</span>
  </a>
  <nav aria-label="Main" class="flex items-center gap-x-1.5 gap-y-1 flex-wrap">
    {
      links.map((link) => (
        <a class="navlink" href={link.href} aria-current={link.match(path) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
    <a
      class="btn btn-fire btn--sm ml-2"
      href="/search/"
      aria-current={path.startsWith("/search/") ? "page" : undefined}
    >
      Search
    </a>
  </nav>
</header>
