---
// One entry in a list: date · type · title with sliding arrow · standfirst or excerpt.
import TypeLabel from "./TypeLabel.astro";
import { getAuthorInfo, type ProcessedPost } from "../../lib/posts";
import TitleArrow from "./TitleArrow.astro";

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
const byline = post.author === "Queen" ? undefined : getAuthorInfo(post.author).name;
---

<a class="row" href={post.slug}>
  <time class="mono row-date" datetime={post.date}>{post.dateMedium}</time>
  <TypeLabel type={post.type} class="row-type" />
  <span class="row-main">
    <span class="ttl"><TitleArrow post={post} /></span>
    {byline && <span class="mono row-by">by {byline}</span>}
    <span class="row-desc">{post.standfirst || post.description}</span>
  </span>
</a>
