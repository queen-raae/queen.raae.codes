---
// A compact archive row: date with the type under it · title. Press rows add the outlet.
import TypeLabel from "./TypeLabel.astro";
import { getAuthorInfo, type ProcessedPost } from "../../lib/posts";

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
const byline = post.author === "Queen" ? undefined : getAuthorInfo(post.author).name;
---

<a class="arow" href={post.slug}>
  <span class="dk">
    <time class="mono d" datetime={post.date}>{post.dateShort}</time>
    <TypeLabel type={post.type} class="k" />
  </span>
  <span class="t"><span>{post.title}</span></span>
  {byline && <span class="mono by">by {byline}</span>}
  {post.type === "Press" && post.outlet && <span class="mono by">{post.outlet}</span>}
</a>
