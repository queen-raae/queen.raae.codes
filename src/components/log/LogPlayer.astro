---
// Square amber play button, a ruled progress bar and mono times.
// `tape` makes it one thick bar: the play button is its first square, the times sit inside it.
// Without `tape`, the default slot sits between the button and the bar, the "track" slot under the bar.
interface Props {
  src: string;
  label: string;
  duration?: string;
  tape?: boolean;
}

const { src, label, duration = "--:--", tape = false } = Astro.props;
const hasSlot = Astro.slots.has("default");
---

<div class:list={["log-player", tape ? "lp-tape" : "flex items-center gap-3.5 flex-wrap"]} data-src={src}>
  <button
    type="button"
    class:list={[
      "lp-play shrink-0 text-ink inline-flex items-center justify-center cursor-pointer p-0 bg-acid hover:bg-ink hover:text-cream",
      !tape && "w-[52px] h-[52px] border-2 border-ink",
    ]}
    aria-label={`Play: ${label}`}
    data-label={label}
  >
    <svg class="lp-icon-play" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"
      ><path d="M5 3l12 7-12 7z" fill="currentColor"></path></svg
    >
    <svg class="lp-icon-pause hidden" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"
      ><path d="M4 3h4v14H4zM12 3h4v14h-4z" fill="currentColor"></path></svg
    >
  </button>
  {
    tape ? (
      <div
        class="lp-bar"
        role="slider"
        tabindex="0"
        aria-label="Seek"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div class="lp-fill" />
        <span class="lp-current mono">00:00</span>
        <span class="lp-duration mono">{duration}</span>
      </div>
    ) : (
      <>
        {hasSlot && (
          <div class="lp-text flex-[1_1_200px] min-w-0">
            <slot />
          </div>
        )}
        <div
          class:list={["flex flex-col gap-1.5 min-w-0", hasSlot ? "lp-track flex-[1.4_1_260px]" : "flex-[1_1_160px]"]}
        >
          <div
            class="lp-bar h-2.5 border-2 border-ink bg-cream box-border relative cursor-pointer"
            role="slider"
            tabindex="0"
            aria-label="Seek"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <div class="lp-fill absolute left-0 top-0 bottom-0 w-0 bg-ink" />
          </div>
          <div class="mono flex justify-between text-plum-500 text-xs!">
            <span class="lp-current">00:00</span>
            <span class="lp-duration">{duration}</span>
          </div>
          <slot name="track" />
        </div>
      </>
    )
  }
</div>

<script>
  import "../../scripts/log-player";
</script>
