---
// Newsletter E: the full-width plum block. The one place the page "breaks character".
interface Props {
  formId?: string;
  tags?: string[];
  copy?: string;
  cta?: string;
}

// ConvertKit form "QUEEN"
const {
  formId = "2454187",
  tags = [],
  copy = "A short note whenever something gets written. No cadence, no funnel, no “just checking in”. One click to leave, and I won’t ask why.",
  cta = "Aye, sign me up",
} = Astro.props;
const emailId = `email-${crypto.randomUUID().slice(0, 8)}`;
---

<section id="mail" class="on-plum ruled gutter py-[clamp(48px,6vw,80px)] flex flex-col">
  <div class="flex gap-[clamp(24px,4vw,64px)] flex-wrap items-end justify-between">
    <div class="flex-[1_1_420px] flex flex-col gap-[18px] min-w-0">
      <h2 class="display m-0 text-[clamp(40px,5.6vw,80px)] leading-[0.95] tracking-[-0.03em]">
        <slot name="title">The log, <span class="acid">by email</span>.</slot>
      </h2>
      <p class="m-0 max-w-[640px] text-[clamp(17px,1.5vw,20px)] leading-normal">{copy}</p>
    </div>
    <form
      class="log-newsletter flex-[1_1_360px] max-w-[560px] flex flex-col gap-3"
      data-form-id={formId}
      data-tags={JSON.stringify(tags)}
    >
      <div class="flex gap-2.5 flex-wrap">
        <label for={emailId} class="sr-only-log">Email address</label>
        <input
          id={emailId}
          name="email"
          type="email"
          required
          placeholder="you@somewhere.no"
          class="field flex-[1_1_220px]"
        />
        <button type="submit" class="btn btn-fire border-acid!">{cta}</button>
      </div>
      <p class="mono m-0 min-h-5 text-acid" role="status" aria-live="polite" data-status></p>
    </form>
  </div>
</section>

<script>
  const messages = {
    pending: "Hold on…",
    success: "Almost there. Check your inbox to confirm.",
    error: "Something went wrong. Try again?",
  };

  document.querySelectorAll<HTMLFormElement>(".log-newsletter").forEach((form) => {
    const status = form.querySelector<HTMLElement>("[data-status]");
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const tags = JSON.parse(form.dataset.tags || "[]");

    const setStatus = (key: keyof typeof messages) => {
      if (status) status.textContent = messages[key];
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!input || !button) return;

      button.disabled = true;
      setStatus("pending");

      try {
        const response = await fetch(`https://api.convertkit.com/v3/forms/${form.dataset.formId}/subscribe`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            api_key: import.meta.env.PUBLIC_CK_API_KEY,
            email: input.value,
            tags,
          }),
        });

        if (!response.ok) throw new Error("Subscription failed");

        input.value = "";
        setStatus("success");
        if ((window as any).fathom) (window as any).fathom.trackGoal("LPC2JAXX", 0);
      } catch (error) {
        console.warn(error);
        setStatus("error");
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
