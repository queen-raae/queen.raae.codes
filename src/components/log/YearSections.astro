---
// Entries grouped by year. Wide screens: the year sits big in a panel-coloured left margin (L3).
// Small screens: the year bar on top.
import SectionBar from "./SectionBar.astro";
import ArchiveRow from "./ArchiveRow.astro";
import CollectedStrip from "./CollectedStrip.astro";
import { findsByYear } from "../../data/collected";
import { groupByYear, type ProcessedPost } from "../../lib/posts";

interface Props {
  posts: ProcessedPost[];
  jumpTo?: string;
  /** Show the year's Collected specimens as a strip above its entries (the log archive only) */
  withCollected?: boolean;
}

const { posts, jumpTo, withCollected = false } = Astro.props;
const years = groupByYear(posts);
const count = (n: number) => `${n} ${n === 1 ? "entry" : "entries"}`;
---

{
  years.map(({ year, posts }) => {
    const guests = posts.filter((post) => post.author !== "Queen").length;
    const finds = withCollected ? findsByYear(year) : [];
    return (
      <section id={`y${year}`} class="ruled year-section scroll-mt-4">
        <div class="year-bar">
          <SectionBar title={year} note={`· ${count(posts.length)}`}>
            {jumpTo && (
              <a class="navlink" href={jumpTo}>
                ↑ Years
              </a>
            )}
          </SectionBar>
        </div>
        <aside class="year-margin">
          <div class="year-margin-inner">
            <span class="display year-big" aria-hidden="true">
              {year}
            </span>
            <span class="mono">{count(posts.length)}</span>
            {guests > 0 && <span class="mono">{guests} by guests</span>}
            {finds.length > 0 && (
              <span class="mono">{finds.length === 1 ? "1 specimen" : `${finds.length} specimens`}</span>
            )}
            {jumpTo && (
              <a class="navlink -ml-2.5 self-start" href={jumpTo}>
                ↑ Years
              </a>
            )}
          </div>
        </aside>
        <div class="year-rows">
          {finds.length > 0 && <CollectedStrip heading={`Collected in ${year}`} finds={finds} />}
          {posts.map((post) => (
            <ArchiveRow post={post} />
          ))}
        </div>
      </section>
    );
  })
}
