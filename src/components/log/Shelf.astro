---
// Book spines: the most recent books, each one its own colour block.
import type { ReadingItem } from "../../lib/reading";

interface Props {
  books: ReadingItem[];
}

const { books } = Astro.props;
const colours = ["book--ink", "book--acid", "book--plum", "book--panel", "book--cream"];
const surname = (name?: string) => (name ? name.split(" ").slice(-1)[0] : "");
---

<div class="gutter flex gap-4 flex-wrap items-end py-[clamp(24px,3vw,40px)]">
  {
    books.map((book, index) => (
      <a class:list={["book", colours[index % colours.length]]} href={book.href}>
        <span class="mono text-xs!">{surname(book.creator)}</span>
        <span class="display text-[20px] leading-[1.05]">{book.title}</span>
      </a>
    ))
  }
</div>
