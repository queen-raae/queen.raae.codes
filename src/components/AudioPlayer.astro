---
interface Props {
  src: string;
  label?: string;
  /**
   * "inline" sits flush inside a byline row (no box of its own).
   * The other variants are kept for backwards compatibility and render
   * the same player inside a static paper box with an ink edge.
   */
  variant?: "pill" | "minimal" | "dark" | "inline";
}

const { src, label = "Listen to this post", variant = "pill" } = Astro.props;
const labelId = `ap-label-${crypto.randomUUID().slice(0, 8)}`;
---

<div
  class:list={["ap", variant !== "inline" && "ap--boxed"]}
  data-audio-src={src}
  role="group"
  aria-labelledby={labelId}
>
  <button class="ap-btn ap-play" type="button" aria-label="Play">
    <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
      <polygon points="7,4 20,12 7,20"></polygon>
    </svg>
    <svg
      class="icon-pause"
      viewBox="0 0 24 24"
      fill="currentColor"
      width="18"
      height="18"
      aria-hidden="true"
      style="display:none"
    >
      <rect x="5" y="4" width="5" height="16"></rect>
      <rect x="14" y="4" width="5" height="16"></rect>
    </svg>
  </button>

  <div class="ap-main">
    <span class="ap-label qr-label" id={labelId}>{label}</span>
    <div class="ap-row">
      <div
        class="ap-bar"
        role="slider"
        tabindex="0"
        aria-label="Seek"
        aria-valuemin="0"
        aria-valuemax="0"
        aria-valuenow="0"
        aria-valuetext="0:00"
      >
        <div class="ap-track"><div class="ap-fill"></div></div>
      </div>
      <span class="ap-time qr-meta">0:00</span>
    </div>
  </div>

  <button class="ap-btn ap-speed" type="button" aria-label="Playback speed 1×">1×</button>
</div>

<style>
  .ap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    user-select: none;
  }

  /* Legacy variants: the same player in a static box (no shadow — only the buttons are clickable) */
  .ap--boxed {
    padding: 0.75rem 1rem;
    border: 2px solid var(--color-ink);
    background-color: var(--color-paper);
  }

  /* Square push buttons: ink edge, hard shadow, lift + gold on hover, press flat */
  .ap-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--color-ink);
    border-radius: 0;
    box-shadow: var(--shadow-brutal-sm);
    cursor: pointer;
    transition:
      transform 0.08s ease,
      box-shadow 0.08s ease,
      background-color 0.08s ease,
      color 0.08s ease;
  }

  @media (hover: hover) {
    .ap-btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--shadow-brutal);
      background-color: var(--color-gold);
      color: var(--color-ink);
    }
  }

  .ap-btn:active {
    transform: translate(3px, 3px);
    box-shadow: none;
  }

  .ap-play {
    background-color: var(--color-plum-500);
    color: var(--color-cream);
  }

  .ap-speed {
    padding: 0 0.4rem;
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .ap-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ap-label {
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ap-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* The slider's hit area reaches past the visible track without taking up room */
  .ap-bar {
    flex: 1;
    min-width: 4rem;
    padding: 0.35rem 0 0.8rem;
    margin: -0.35rem 0 -0.8rem;
    cursor: pointer;
  }

  .ap-track {
    height: 0.8rem;
    border: 2px solid var(--color-ink);
    background-color: var(--color-paper);
    overflow: hidden;
    transition: background-color 0.08s ease;
  }

  /* Plum progress with an orangered playhead */
  .ap-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-plum-500);
    border-right: 3px solid var(--color-orangered);
    transition: width 0.1s linear;
  }

  @media (hover: hover) {
    .ap-bar:hover .ap-track {
      background-color: var(--color-gold);
    }
  }

  .ap-bar:focus-visible {
    outline: none;
  }

  .ap-bar:focus-visible .ap-track {
    outline: 3px solid var(--color-orangered);
    outline-offset: 3px;
  }

  .ap-time {
    flex-shrink: 0;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>(".ap").forEach((player) => {
    const src = player.dataset.audioSrc!;
    const audio = new Audio(src);
    const playBtn = player.querySelector<HTMLButtonElement>(".ap-play")!;
    const iconPlay = player.querySelector<SVGElement>(".icon-play")!;
    const iconPause = player.querySelector<SVGElement>(".icon-pause")!;
    const bar = player.querySelector<HTMLDivElement>(".ap-bar")!;
    const fill = player.querySelector<HTMLDivElement>(".ap-fill")!;
    const time = player.querySelector<HTMLSpanElement>(".ap-time")!;
    const speedBtn = player.querySelector<HTMLButtonElement>(".ap-speed")!;

    const speeds = [1, 1.25, 1.5, 1.75, 2];
    let si = 0;

    function fmt(s: number): string {
      const m = Math.floor(s / 60);
      return `${m}:${Math.floor(s % 60)
        .toString()
        .padStart(2, "0")}`;
    }

    // Fathom analytics
    const fathom = () => (window as any).fathom;
    const milestones = new Set<number>();

    function trackAudio(event: string, value = 0) {
      if (fathom()) fathom().trackEvent(`audio:${event}`, { _value: value });
    }

    function showPlaying(playing: boolean) {
      iconPlay.style.display = playing ? "none" : "block";
      iconPause.style.display = playing ? "block" : "none";
      playBtn.setAttribute("aria-label", playing ? "Pause" : "Play");
    }

    function updateSlider() {
      const duration = audio.duration || 0;
      bar.setAttribute("aria-valuemax", String(Math.floor(duration)));
      bar.setAttribute("aria-valuenow", String(Math.floor(audio.currentTime)));
      bar.setAttribute("aria-valuetext", duration ? `${fmt(audio.currentTime)} of ${fmt(duration)}` : "0:00");
    }

    function seekTo(seconds: number) {
      if (!audio.duration) return;
      audio.currentTime = Math.min(Math.max(seconds, 0), audio.duration);
    }

    playBtn.addEventListener("click", () => {
      if (audio.paused) {
        audio.play().catch(() => showPlaying(false));
        showPlaying(true);
        trackAudio("play");
      } else {
        audio.pause();
        showPlaying(false);
      }
    });

    audio.addEventListener("timeupdate", () => {
      if (!audio.duration) return;
      const pct = (audio.currentTime / audio.duration) * 100;
      fill.style.width = `${pct}%`;
      time.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
      updateSlider();

      // Track retention milestones
      for (const m of [25, 50, 75]) {
        if (pct >= m && !milestones.has(m)) {
          milestones.add(m);
          trackAudio(`listened:${m}%`, m);
        }
      }
    });

    audio.addEventListener("ended", () => {
      showPlaying(false);
      fill.style.width = "0%";
      if (!milestones.has(100)) {
        milestones.add(100);
        trackAudio("listened:100%", 100);
      }
    });

    audio.addEventListener("loadedmetadata", () => {
      time.textContent = `0:00 / ${fmt(audio.duration)}`;
      updateSlider();
    });

    // Click (or tap) anywhere on the track to jump there
    bar.addEventListener("click", (e: MouseEvent) => {
      if (!audio.duration) return;
      const rect = bar.getBoundingClientRect();
      seekTo(((e.clientX - rect.left) / rect.width) * audio.duration);
    });

    // Keyboard: arrows ±5 s, Page Up/Down ±30 s, Home/End
    bar.addEventListener("keydown", (e: KeyboardEvent) => {
      const steps: Record<string, number> = {
        ArrowRight: 5,
        ArrowUp: 5,
        ArrowLeft: -5,
        ArrowDown: -5,
        PageUp: 30,
        PageDown: -30,
      };
      let target: number | undefined;
      if (e.key in steps) target = audio.currentTime + steps[e.key];
      else if (e.key === "Home") target = 0;
      else if (e.key === "End") target = audio.duration;
      if (target === undefined) return;
      e.preventDefault();
      seekTo(target);
    });

    speedBtn.addEventListener("click", () => {
      si = (si + 1) % speeds.length;
      audio.playbackRate = speeds[si];
      speedBtn.textContent = `${speeds[si]}×`;
      speedBtn.setAttribute("aria-label", `Playback speed ${speeds[si]}×`);
    });
  });
</script>
