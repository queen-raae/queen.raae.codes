---
interface ContentItem {
  to?: string;
  href?: string;
  primary: string;
  secondary?: string;
  body?: string;
}

interface CtaItem {
  to?: string;
  href?: string;
  label: string;
}

interface Props {
  items?: ContentItem[];
  ctas?: CtaItem[];
  /** Show 01, 02, 03… in front of each row */
  numbered?: boolean;
  class?: string;
}

const { items = [], ctas = [], numbered = false, class: className } = Astro.props;
---

<ul class:list={["content-list m-0 list-none border-t-4 border-ink p-0", className]}>
  {
    items.map((item, index) => {
      const { primary, secondary, body, to, href } = item;
      const linkHref = to || href;
      const isExternal = Boolean(href);

      return (
        <li class="content-list-item border-b border-ink">
          <a
            href={linkHref}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noreferrer" : undefined}
            class="content-list-link group flex gap-4 px-1.5 py-3.5 text-ink no-underline transition-colors hover:bg-gold"
          >
            {numbered && (
              <span
                class="qr-label w-6 shrink-0 pt-[0.3rem] text-plum-400 group-hover:text-plum-500"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, "0")}
              </span>
            )}
            <span class="flex min-w-0 flex-1 flex-col gap-1">
              <h3 class="content-list-title font-body my-0 text-[1.1rem] leading-snug font-bold text-balance text-ink">
                <Fragment set:html={primary} />
                <span
                  class="content-list-arrow ml-1 inline-block text-ember transition-transform group-hover:translate-x-1 group-hover:text-ink"
                  aria-hidden="true"
                >
                  {isExternal ? "↗" : "→"}
                </span>
              </h3>
              {body && <Fragment set:html={body} />}
              {secondary && <p class="qr-meta my-0 group-hover:text-plum-500" set:html={secondary} />}
            </span>
          </a>
        </li>
      );
    })
  }

  {
    ctas.map((item, index) => {
      const { to, href, label } = item;
      const linkHref = to || href;
      const isExternal = Boolean(href);

      return (
        <li class:list={[index === 0 ? "pt-10" : "pt-3"]}>
          <a
            href={linkHref}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noreferrer" : undefined}
            class="qr-btn w-full justify-between"
          >
            <span>{label}</span>
            <span aria-hidden="true">{isExternal ? "↗" : "→"}</span>
          </a>
        </li>
      );
    })
  }
</ul>
