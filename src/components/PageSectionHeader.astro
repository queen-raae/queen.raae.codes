---
interface Props {
  badge?: string;
  title?: string;
  titlePath?: string;
  lead?: string;
  tagline?: string;
  hLevel?: number;
  class?: string;
}

const { badge, title, titlePath, lead, tagline, hLevel = 2, class: className } = Astro.props;

const blocks = [
  { type: "badge", children: badge },
  { type: "title", children: title, path: titlePath },
  { type: "lead", children: lead },
  { type: "tagline", children: tagline },
].filter((block) => Boolean(block.children));

function getTag(type: string, baseLevel: number): string {
  // Title is the only heading — the actual page/section topic
  if (type === "title") return `h${baseLevel}`;
  // Badge is a navigational label (e.g. "Author", "Speaker"), not structural
  // Lead and tagline are also non-heading content
  return "p";
}

function getTitleClass(level: number, text = ""): string {
  // Visual styling based on the section's hLevel (not the actual tag)
  if (level === 1) {
    // Long titles step down so they don't run to 6+ lines on phones (or 4–5 on desktop)
    const plain = text.replace(/<[^>]*>/g, "").trim();
    const longestWord = Math.max(0, ...plain.split(/\s+/).map((word) => word.length));
    const size =
      plain.length > 60
        ? "text-[1.75rem] sm:text-[2.6rem]"
        : plain.length > 40 || longestWord >= 13
          ? "text-[2rem] sm:text-[3.1rem]"
          : "text-[2.4rem] sm:text-[3.1rem]";
    return `font-heading ${size} font-black leading-[0.98] tracking-[-0.04em] mt-4 mb-6 text-ink text-balance break-words`;
  }
  // One h2 size across the site (matches prose h2 in tailwind.config.js)
  return "font-heading text-[1.8rem] font-black leading-[1.05] tracking-[-0.025em] mt-0 mb-6 text-ink text-balance break-words";
}
---

{
  blocks.map((block) => {
    const Tag = getTag(block.type, hLevel) as any;

    if (block.type === "badge") {
      return (
        <Tag class:list={["qr-label text-plum-400", hLevel === 1 ? "mt-6 mb-0" : "mt-0 mb-2", className]}>
          {block.children}
        </Tag>
      );
    }

    if (block.type === "title") {
      return (
        <Tag class:list={[getTitleClass(hLevel, block.children), className]}>
          {block.path ? (
            <a
              href={block.path}
              class="text-inherit no-underline decoration-orangered decoration-[3px] underline-offset-[6px] hover:underline"
            >
              <Fragment set:html={block.children} />
            </a>
          ) : (
            <Fragment set:html={block.children} />
          )}
        </Tag>
      );
    }

    if (block.type === "lead") {
      return (
        <Tag class:list={["font-body mt-4 mb-6 text-xl leading-snug text-plum-500 italic text-pretty", className]}>
          {block.children}
        </Tag>
      );
    }

    if (block.type === "tagline") {
      return <Tag class:list={["my-2 text-ink", className]}>{block.children}</Tag>;
    }

    return null;
  })
}
